        "d1": {
          "kind": "expr",
          "expr": "(a + b + 1) / 10"
        },
        "d2": {
          "kind": "expr",
          "expr": "(a + b - 1) / 10"
        },
        "d3": {
          "kind": "expr",
          "expr": "(a + b) / 100"
        }
      },
      "constraints": [],
      "prompt": "Hitung $ {x} + {y} $.",
      "input": {
        "kind": "choice",
        "shuffle": true,
        "options": [
          {
            "text": "$ {s} $",
            "correct": true,
            "why": "$ {x} + {y} = {s} $."
          },
          {
            "text": "$ {d1} $",
            "correct": false,
            "why": "Kelebihan 0,1 — sejajarkan koma desimalnya."
          },
          {
            "text": "$ {d2} $",
            "correct": false,
            "why": "Kekurangan 0,1 — sejajarkan koma desimalnya."
          },
          {
            "text": "$ {d3} $",
            "correct": false,
            "why": "Koma bergeser satu tempat — hasilnya 10 kali lebih kecil."
          }
        ]
      },
      "explain": "$ {x} + {y} = {s} $."
    }
  ],
