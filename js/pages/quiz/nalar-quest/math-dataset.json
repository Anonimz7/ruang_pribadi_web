        "options": [
          {
            "text": "96",
            "correct": true,
            "why": "$12 \\times 8 = 96$."
          },
          {
            "text": "20",
            "correct": false,
            "why": "$12 + 8$ — itu penjumlahan, bukan perkalian."
          },
          {
            "text": "48",
            "correct": false,
            "why": "$12 \\times 4$ — hanya setengah dari 8."
          },
          {
            "text": "84",
            "correct": false,
            "why": "$12 \\times 7$ — salah satu faktor kurang 1."
          }
        ]
      },
      "explanation": "$12 \\times 8 = 96$."
    },
    {
