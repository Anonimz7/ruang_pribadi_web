        "options": [
          {
            "text": "Rp150.000",
            "correct": true,
            "why": "$200.000 \\times 25\\% = 50.000$ diskonnya, jadi $200.000 - 50.000 = 150.000$."
          },
          {
            "text": "Rp50.000",
            "correct": false,
            "why": "Itu besar diskonnya, bukan harga setelah diskon."
          },
          {
            "text": "Rp175.000",
            "correct": false,
            "why": "Itu $200.000 - 25.000$ — 25% disalahartikan sebagai Rp25.000."
          },
          {
            "text": "Rp160.000",
            "correct": false,
            "why": "Itu harga bila diskonnya 20%, bukan 25%."
          }
        ]
      },
      "explanation": "Diskon $25\\%$ dari $Rp200.000$ adalah $Rp50.000$. Harga akhir: $Rp200.000 - Rp50.000 = Rp150.000$."
