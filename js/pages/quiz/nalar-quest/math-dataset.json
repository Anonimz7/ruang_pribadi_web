{
  "version": "0.7.2",
  "description": "Bank awal Matematika — drilling acak (template + statis), LaTeX.",
  "templates": [
    {
      "id": "math.aritmetika.001",
      "type": "math",
      "domain": "angka",
      "principle": "penjumlahan",
      "surface_domain": "matematis",
      "surface_distance": 0,
      "contrast_with": [],
      "difficulty": 1,
      "vars": {
        "a": {
          "kind": "int",
          "min": 12,
          "max": 89
        },
        "b": {
          "kind": "int",
          "min": 12,
          "max": 89
        },
        "s": {
          "kind": "expr",
          "expr": "a + b"
        },
        "d1": {
          "kind": "expr",
          "expr": "a + b + 10"
        },
        "d2": {
          "kind": "expr",
          "expr": "a + b - 10"
        },
        "d3": {
          "kind": "expr",
          "expr": "a + b + 1"
        }
      },
      "constraints": [],
      "prompt": "Hitung $ {a} + {b} $.",
      "input": {
        "kind": "choice",
        "shuffle": true,
        "options": [
          {
            "text": "$ {s} $",
            "correct": true,
            "why": "$ {a} + {b} = {s} $."
          },
          {
            "text": "$ {d1} $",
            "correct": false,
            "why": "Kelebihan 10 — periksa lagi puluhan."
          },
          {
            "text": "$ {d2} $",
            "correct": false,
            "why": "Kekurangan 10 — periksa lagi puluhan."
          },
          {
            "text": "$ {d3} $",
            "correct": false,
            "why": "Kelebihan 1 — periksa lagi satuan."
          }
        ]
      },
      "explain": "$ {a} + {b} = {s} $."
    },
    {
      "id": "math.pecahan.001",
      "type": "math",
      "domain": "angka",
      "principle": "penjumlahan_pecahan",
      "surface_domain": "matematis",
      "surface_distance": 0,
      "contrast_with": [],
      "difficulty": 2,
      "vars": {
        "a": {
          "kind": "int",
          "min": 1,
          "max": 8
        },
        "b": {
          "kind": "int",
          "min": 3,
          "max": 9
        },
        "c": {
          "kind": "int",
          "min": 1,
          "max": 8
        },
        "d": {
          "kind": "int",
          "min": 3,
          "max": 9
        },
        "n": {
          "kind": "expr",
          "expr": "a * d + c * b"
        },
        "m": {
          "kind": "expr",
          "expr": "b * d"
        },
        "n2": {
          "kind": "expr",
          "expr": "a + c"
        },
        "m2": {
          "kind": "expr",
          "expr": "b + d"
        },
        "n3": {
          "kind": "expr",
          "expr": "a + c"
        },
        "m3": {
          "kind": "expr",
          "expr": "b * d"
        }
      },
      "constraints": [
        "a < b",
        "c < d"
      ],
      "prompt": "Hitung $ \\frac{{a}}{{b}} + \\frac{{c}}{{d}} $.",
      "input": {
        "kind": "choice",
        "shuffle": true,
        "options": [
          {
            "text": "$ \\frac{{n}}{{m}} $",
            "correct": true,
            "why": "Penyebut disamakan: $ \\frac{{n}}{{m}} $."
          },
          {
            "text": "$ \\frac{{n2}}{{m2}} $",
            "correct": false,
            "why": "Pembilang dan penyebut tidak boleh dijumlah langsung."
          },
          {
            "text": "$ \\frac{{n3}}{{m3}} $",
            "correct": false,
            "why": "Pembilang dijumlah tapi penyebut dikali — penyebut harus disamakan dulu."
          },
          {
            "text": "$ \\frac{{n}}{{m2}} $",
            "correct": false,
            "why": "Pembilang sudah benar, tapi penyebutnya dijumlah, bukan dikali."
          }
        ]
      },
      "explain": "Samakan penyebut: $ \\frac{{a}}{{b}} + \\frac{{c}}{{d}} = \\frac{a \\times d + c \\times b}{b \\times d} = \\frac{{n}}{{m}} $."
    },
    {
      "id": "math.aritmetika.002",
      "type": "math",
      "domain": "angka",
      "principle": "pangkat_dua",
      "surface_domain": "matematis",
      "surface_distance": 0,
      "contrast_with": [],
      "difficulty": 1,
      "vars": {
        "a": {
          "kind": "int",
          "min": 3,
          "max": 15
        },
        "s": {
          "kind": "expr",
          "expr": "a * a"
        },
        "d1": {
          "kind": "expr",
          "expr": "2 * a"
        },
        "d2": {
          "kind": "expr",
          "expr": "a * a + 1"
        },
        "d3": {
          "kind": "expr",
          "expr": "a * a - 1"
        }
      },
      "constraints": [],
      "prompt": "Hitung $ {a}^2 $.",
      "input": {
        "kind": "choice",
        "shuffle": true,
        "options": [
          {
            "text": "$ {s} $",
            "correct": true,
            "why": "$ {a}^2 = {a} \\times {a} = {s} $."
          },
          {
            "text": "$ {d1} $",
            "correct": false,
            "why": "$2 \\times {a}$ bukan ${a}^2$ — pangkat berarti dikali dirinya sendiri."
          },
          {
            "text": "$ {d2} $",
            "correct": false,
            "why": "Kelebihan 1 — periksa lagi perkaliannya."
          },
          {
            "text": "$ {d3} $",
            "correct": false,
            "why": "Kekurangan 1 — periksa lagi perkaliannya."
          }
        ]
      },
      "explain": "$ {a}^2 = {a} \\times {a} = {s} $."
    },
    {
      "id": "math.desimal.001",
